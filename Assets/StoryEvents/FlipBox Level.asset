  m_Script: {fileID: 11500000, guid: 27aca8f6da03658478ee1dc44eab7429, type: 3}
  m_Name: FlipBox Level
  m_EditorClassIdentifier: 
  <storyEventSteps>k__BackingField:
  - stepName: Step 1
    <eventImage>k__BackingField: {fileID: 21300000, guid: 40f2e846b4a5723459d177c2628ddb94, type: 3}
    <eventText>k__BackingField: 'Chiyo: Sometimes, it''d be better to rotate the
      other way, right? '
    <playTransitionToNextStep>k__BackingField: 0
  - stepName: Step 2
    <eventImage>k__BackingField: {fileID: 21300000, guid: 40f2e846b4a5723459d177c2628ddb94, type: 3}
    <eventText>k__BackingField: "Rusty: Yep. But I get too caught up in spinning
      to turn on my own\u2026 "
    <playTransitionToNextStep>k__BackingField: 0
  - stepName: Step 3
    <eventImage>k__BackingField: {fileID: 21300000, guid: 40f2e846b4a5723459d177c2628ddb94, type: 3}
    <eventText>k__BackingField: 'Rusty: So I''ve gotta use a flipbox to start going
      the other way. '
    <playTransitionToNextStep>k__BackingField: 0
  - stepName: Step 4
    <eventImage>k__BackingField: {fileID: 21300000, guid: 40f2e846b4a5723459d177c2628ddb94, type: 3}
    <eventText>k__BackingField: 'Rusty: Then I''m good.'
    <playTransitionToNextStep>k__BackingField: 0
  - stepName: Step 5
    <eventImage>k__BackingField: {fileID: 21300000, guid: 5cd1a71cf76a6c547b92796a97ccc6b9, type: 3}
    <eventText>k__BackingField: 'Rusty: I''m really good at rotating! I''m the greatest
      rotator who ever rotated!'
    <playTransitionToNextStep>k__BackingField: 0
